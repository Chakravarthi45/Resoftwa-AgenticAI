*&---------------------------------------------------------------------*
*& Report zpo_open_list
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zpo_open_list.
TYPES:BEGIN OF ty_po,
        ebeln TYPE ekko-ebeln,
        lifnr TYPE ekko-lifnr,
        bedat TYPE ekko-bedat,
        ebelp TYPE ekpo-ebelp,
        matnr TYPE ekpo-matnr,
        menge TYPE ekpo-menge,
      END OF ty_po.
DATA: gv_lifnr TYPE ekko-lifnr,
      gv_bedat TYPE ekko-bedat,
      lt_po    TYPE TABLE OF ty_po.
DATA: lo_alv TYPE REF TO cl_salv_table.
SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE text-001.
SELECT-OPTIONS: s_lifnr FOR gv_lifnr,
 s_bedat FOR gv_bedat.
SELECTION-SCREEN END OF BLOCK b1.
START-OF-SELECTION.

  SELECT a~ebeln, a~lifnr, a~bedat, b~ebelp, b~matnr, b~menge
          FROM  ekko AS a INNER JOIN ekpo AS b ON b~ebeln = a~ebeln  INTO TABLE @lt_po
          WHERE a~lifnr IN @s_lifnr AND a~bedat IN @s_bedat.
  TRY.
      cl_salv_table=>factory(
*          EXPORTING
*            list_display   = if_salv_c_bool_sap=>false
*            r_container    =
*            container_name =
        IMPORTING
          r_salv_table   =  lo_alv
        CHANGING
          t_table        = lt_po
      ).
    CATCH cx_salv_msg.
  ENDTRY.
  call method lo_alv->display.
